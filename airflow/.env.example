# Airflow Docker environment for Walmart M5
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5
AIRFLOW_UID=501

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Databricks connection (fill these in) ---
# Host example: https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXX

# Job ID from Databricks → Jobs → walmart_m5_medallion
WALMART_M5_DATABRICKS_JOB_ID=000000000000000

# Airflow connection (JSON). Password = Databricks PAT.
AIRFLOW_CONN_DATABRICKS_DEFAULT={"conn_type":"databricks","host":"https://YOUR_WORKSPACE.cloud.databricks.com","password":"dapiXXXXXXXXXXXXXXXX"}
